{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "rootDir": "src",
        "outDir": "dist",
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "declaration": false
    },
    "include": [
        "src"
    ],
    "exclude": [
        "node_modules",
        "src/dashboard/client"
    ]
}

# ────────────────────────────────────────────────────────────────
#  RLOrgs · Konfiguration
#  Diese Datei gehört NICHT ins Git. Werte immer in "..." setzen —
#  ein unmaskiertes # startet sonst einen Kommentar und der Wert
#  wird still leer.
#
#  Es gibt keine config.json mehr: alles steht hier. Wer im
#  Dashboard welche Gruppe hat, steht in der Datenbank und wird
#  unter /dashboard/admins vergeben — nicht in dieser Datei.
# ────────────────────────────────────────────────────────────────

# ── Discord · Produktion ────────────────────────────────────────
CLIENT_TOKEN="DEIN_BOT_TOKEN"
CLIENT_ID="DEINE_APPLICATION_ID"
# Nur fuers Dashboard - OAuth2 > Client Secret im Developer Portal
CLIENT_SECRET="DEIN_CLIENT_SECRET"

# ── Discord · Entwicklung (--dev) ───────────────────────────────
DEV_CLIENT_TOKEN="DEIN_BOT_TOKEN"
DEV_CLIENT_ID="DEINE_APPLICATION_ID"
DEV_CLIENT_SECRET="DEIN_CLIENT_SECRET"
# Server, auf dem Commands im Dev-Modus sofort registriert werden
DEV_GUILD_ID="DEINE_DEV_SERVER_ID"
# Kommagetrennt. Schaltet die Entwickler-Befehle frei und ist der
# Einstieg ins Admin-Dashboard, ueber das alle weiteren Gruppen
# vergeben werden - deshalb steht diese eine Liste noch hier.
DEV_USER_IDs="DEINE_USER_ID"

# ── Datenbank (MariaDB) ─────────────────────────────────────────
# Leer lassen heisst: der Bot laeuft ohne Datenbank weiter.
DATABASE_HOST="localhost"
DATABASE_PORT="3306"
DATABASE_NAME="rlnexus"
DATABASE_POOL_LIMIT="5"
DATABASE_USER="rlnexus"
# Nur fuer Docker: Root-Konto des Containers, phpMyAdmin-Login.
DATABASE_ROOT_PASSWORD="DEIN_ROOT_PASSWORT"
DATABASE_PASSWORD="DEIN_DB_PASSWORT"

# ── Webserver ───────────────────────────────────────────────────
# Neues Secret erzeugen: npm run token -- --secret
SERVER_JWT_SECRET="MIT npm run token -- --secret ERZEUGEN"
SERVER_PORT="3000"
# Die eigene Domain des Dashboards. Im --dev Modus ungenutzt: dort laeuft alles
# unter http://localhost:<SERVER_PORT>/dashboard, im Betrieb liegt das Dashboard
# an der Wurzel dieser Adresse.
SERVER_PUBLIC_URL="https://dashboard.nexus-emb.de"
# Die Hauptseite. Das Dashboard verlinkt in der Fusszeile dorthin.
SITE_PUBLIC_URL="https://nexus-emb.de"
SERVER_JWT_EXPIRES_IN="30d"
SERVER_RATE_LIMIT_MAX="100"
SERVER_RATE_LIMIT_WINDOW="1 minute"

# ── Discord-Sonstiges ───────────────────────────────────────────
# Privilegiertes Intent - nur an, wenn es im Developer Portal
# ebenfalls an ist, sonst weist Discord den Login rundweg ab.
GUILD_MEMBER_INTENT="false"

# ── Rocket League (prime.rocketplanet.gg) ───────────────────────
# Fuer das Rang-Tracking im Dashboard. Token unter
# https://prime.rocketplanet.gg/access holen. Leer = kein Tracking.
PRIME_API_TOKEN=""

# ── Epic Games Login (Konto verknuepfen) ────────────────────────
# Client-ID und Secret aus dem Epic Developer Portal:
# dev.epicgames.com > Product Settings > Clients. Dort muss unter
# "Redirect URL" exakt diese Adresse stehen:
#   http://localhost:<SERVER_PORT>/dashboard/link/epic/callback   (--dev)
#   <SERVER_PUBLIC_URL>/link/epic/callback                        (Betrieb)
# Leer = kein Epic-Login, das Dashboard sagt das in den Einstellungen.
EPIC_CLIENT_ID=""
EPIC_CLIENT_SECRET=""

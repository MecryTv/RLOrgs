{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": [],
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "rootDir": "client",
        "outDir": "public/assets",
        "declaration": false,
        "sourceMap": false
    },
    "include": ["client/**/*.ts"]
}
